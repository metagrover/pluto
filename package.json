{
  "name": "pluto",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build-swift": "mkdir -p resources/bin && swiftc resources/swift/main.swift resources/swift/AudioRecorder.swift -o resources/bin/recorder && codesign --sign - --entitlements resources/swift/entitlements.plist --force resources/bin/recorder",
    "build-native": "pnpm run build-swift && pnpm run build:audio-cap",
    "build": "tsc && vite build && pnpm run build-python && electron-builder",
    "build:audio-cap": "mkdir -p resources/bin && swiftc resources/swift/audiocap/*.swift -o resources/bin/audiocap -framework CoreAudio -framework AudioToolbox -framework AVFoundation",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "fix": "biome check . --write",
    "preview": "vite preview",
    "test:synthetic-attribution": "vitest run tests/unit/speakerAttribution.synthetic.test.ts",
    "setup-python": "./scripts/setup_python.sh",
    "build-python": "./scripts/build_python.sh",
    "postinstall": "pnpm run setup-python",
    "prepare": "lefthook install",
    "audit:high": "pnpm audit --audit-level high",
    "test": "vitest",
    "replay:meeting": "node scripts/replay_meeting_attribution.js",
    "test:meeting-regression": "node scripts/replay_meeting_attribution.js --fixture-file scripts/replay.local-fixtures.json --attempts 1 --require-expected --all-sets"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.21",
    "@xyflow/react": "^12.10.1",
    "better-sqlite3": "^12.5.0",
    "cross-spawn": "^7.0.6",
    "dagre": "^0.8.5",
    "fast-levenshtein": "^3.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "undici": "^6.24.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/dagre": "^0.7.54",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "electron": "40.6.0",
    "electron-builder": "^26.8.1",
    "lefthook": "^1.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.18"
  },
  "main": "dist-electron/main.js",
  "pnpm": {
    "overrides": {
      "minimatch": "10.2.4",
      "tar": "7.5.11",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3"
    }
  },
  "volta": {
    "node": "24.11.0"
  }
}
