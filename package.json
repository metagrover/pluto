{
  "name": "pluto",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/metagrover/pluto.git"
  },
  "scripts": {
    "predev": "pnpm run ensure:dev-runtime",
    "dev": "vite",
    "prestart": "pnpm run ensure:dev-runtime",
    "start": "node scripts/start_production_profile.mjs",
    "prebuild": "node scripts/clean_generated_electron_output.mjs",
    "build-native": "pnpm run ensure:media-tools && pnpm run build:audio-cap && pnpm run build:calendar-helper && pnpm run build:parakeet",
    "build": "tsc && vite build && pnpm run build-native && electron-builder",
    "build:parakeet": "./scripts/build_parakeet.sh",
    "ensure:dev-runtime": "pnpm run ensure:media-tools && pnpm run ensure:sqlite-abi && pnpm run ensure:parakeet && pnpm run ensure:audio-cap && pnpm run ensure:calendar-helper",
    "ensure:sqlite-abi": "node scripts/ensure_sqlite_abi.mjs",
    "ensure:parakeet": "./scripts/ensure_parakeet_runtime.sh",
    "ensure:audio-cap": "./scripts/ensure_audio_cap_runtime.sh",
    "ensure:calendar-helper": "test -x resources/bin/PlutoCalendarHelper.app/Contents/MacOS/PlutoCalendarHelper || pnpm run build:calendar-helper",
    "build:audio-cap": "./scripts/build_audio_cap.sh",
    "build:calendar-helper": "./scripts/build_calendar_helper.sh",
    "ensure:media-tools": "node scripts/verify_media_runtime.mjs",
    "package:verify-runtime": "node scripts/verify_packaged_runtime.mjs",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "fix": "biome check . --write",
    "preview": "vite preview",
    "test:synthetic-attribution": "vitest run tests/unit/speakerAttribution.synthetic.test.ts",
    "setup-python": "./scripts/setup_python.sh",
    "fix-sqlite-abi": "npx electron-rebuild -f -w better-sqlite3",
    "prepare": "lefthook install",
    "audit:high": "node scripts/audit-high.mjs",
    "test": "vitest",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "benchmark:recording-quality": "node --experimental-strip-types scripts/run_recording_quality_benchmark.ts",
    "benchmark:encrypted-storage": "node --expose-gc --experimental-strip-types scripts/benchmark_encrypted_storage.ts",
    "benchmark:private-transcription:validate": "node --experimental-strip-types scripts/validate_private_transcription_manifest.ts",
    "benchmark:private-parakeet-eou:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate_private_parakeet_eou_manifest.ts",
    "replay:parakeet-eou": "vitest run --disableConsoleIntercept --config vitest.manual.config.ts tests/manual/parakeetEouCausalReplay.test.ts",
    "benchmark:private-parakeet": "node --experimental-strip-types scripts/evaluate_private_parakeet.ts",
    "benchmark:private-parakeet:review": "node --experimental-strip-types scripts/evaluate_private_parakeet_review.ts",
    "benchmark:private-speaker-attribution:validate": "node --experimental-strip-types scripts/validate_private_speaker_attribution_manifest.ts",
    "benchmark:speaker-attribution": "node --experimental-strip-types scripts/run_local_speaker_attribution_benchmark.ts",
    "benchmark:production-speaker-attribution": "node --experimental-strip-types scripts/run_production_speaker_attribution_acceptance.ts",
    "benchmark:meeting-notes-quality": "RUN_MEETING_NOTES_PROVIDER_BENCHMARK=1 vitest run --config vitest.benchmark.config.ts --reporter=verbose",
    "benchmark:intelligence-providers": "RUN_MEETING_NOTES_PROVIDER_BENCHMARK=1 vitest run --config vitest.benchmark.config.ts --reporter=verbose",
    "benchmark:meeting-notes-latency:validate": "tsx scripts/validate_private_meeting_notes_latency_manifest.ts",
    "benchmark:meeting-summaries": "tsx scripts/benchmark_meeting_summaries.ts",
    "benchmark:meeting-notes-latency": "tsx scripts/run_meeting_notes_latency_benchmark.ts",
    "report:meeting-notes-latency": "tsx scripts/report_meeting_notes_latency.ts",
    "report:meeting-notes-trust-cost": "tsx scripts/report_meeting_notes_trust_cost.ts",
    "benchmark:ask-pluto": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/run_ask_pluto_benchmark.ts",
    "benchmark:meeting-notes-quality:score-fixtures": "node scripts/evaluate_meeting_notes_quality.js",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:build": "node scripts/changelog.mjs build",
    "db:generate": "drizzle-kit generate --name",
    "db:check": "drizzle-kit check",
    "backfill:meeting-intelligence": "node scripts/backfill_meeting_title_analysis.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@google/genai": "^2.22.0",
    "@tanstack/react-query": "^5.90.21",
    "better-sqlite3": "^12.5.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "fast-levenshtein": "^3.0.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "undici": "^6.27.0",
    "unpdf": "^1.8.1",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.10",
    "electron": "40.8.0",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.11.1",
    "lefthook": "^1.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2",
    "vite": "^7.3.5",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.0"
  },
  "main": "dist-electron/bootstrap.js",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "lodash@>=4.0.0 <=4.17.23": "4.18.0",
      "minimatch": "10.2.4",
      "tmp@<0.2.7": "0.2.7",
      "tar": "7.5.11",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "esbuild@<0.28.1": "0.28.1",
      "form-data@<4.0.6": "4.0.6",
      "tmp": "0.2.7"
    }
  },
  "volta": {
    "node": "24.11.0"
  }
}
