{
  "type": "stop_to_validated_latency",
  "scenarios": [
    {
      "id": "healthy",
      "events": [
        { "type": "accept_stop", "atMs": 100 },
        { "type": "complete_validated_save", "atMs": 145 }
      ],
      "expected": {
        "schemaVersion": 1,
        "status": "available",
        "durationMs": 45
      }
    },
    {
      "id": "delayed",
      "events": [
        { "type": "accept_stop", "atMs": 100 },
        { "type": "complete_validated_save", "atMs": 1100 }
      ],
      "expected": {
        "schemaVersion": 1,
        "status": "available",
        "durationMs": 1000
      }
    },
    {
      "id": "not-validated",
      "events": [
        { "type": "accept_stop", "atMs": 100 },
        { "type": "mark_unavailable", "reason": "not_validated" }
      ],
      "expected": {
        "schemaVersion": 1,
        "status": "unavailable",
        "reason": "not_validated"
      }
    },
    {
      "id": "decreasing",
      "events": [
        { "type": "accept_stop", "atMs": 100 },
        { "type": "complete_validated_save", "atMs": 99 }
      ],
      "expected": {
        "schemaVersion": 1,
        "status": "unavailable",
        "reason": "timestamp_regression"
      }
    },
    {
      "id": "completion-before-start",
      "events": [{ "type": "complete_validated_save", "atMs": 100 }],
      "expected": {
        "schemaVersion": 1,
        "status": "unavailable",
        "reason": "not_started"
      }
    },
    {
      "id": "duplicate-completion",
      "events": [
        { "type": "accept_stop", "atMs": 100 },
        { "type": "complete_validated_save", "atMs": 145 },
        { "type": "complete_validated_save", "atMs": 200 }
      ],
      "expected": {
        "schemaVersion": 1,
        "status": "available",
        "durationMs": 45
      }
    }
  ],
  "expected": {
    "status": "validated",
    "primaryMetric": { "name": "durationMs", "value": 45 }
  }
}
