// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.pluto.app",
  "asar": true,
  "productName": "Pluto",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "resources"
  ],
  "extraResources": [
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Pluto needs microphone access to record and transcribe your meetings.",
      "NSCameraUsageDescription": "Pluto needs camera access for screen sharing and meeting contexts.",
      "NSAudioCaptureUsageDescription": "Pluto needs permission to capture system audio for transcription."
    }
  }
}
