// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.pluto.app",
  "asar": true,
  "asarUnpack": ["dist-electron/**", "node_modules/ffmpeg-static/**", "node_modules/@ffprobe-installer/**"],
  "productName": "Pluto",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    { "from": "dist-electron-package", "to": "dist-electron" },
    "resources"
  ],
  "extraResources": [
    {
      "from": "resources/mcp",
      "to": "mcp",
      "filter": ["**/*.mjs"]
    },
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": ["**/*", "!recorder"]
    },
    {
      "from": "resources/model-manifests",
      "to": "model-manifests",
      "filter": ["**/*"]
    },
    {
      "from": "drizzle",
      "to": "drizzle",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Pluto needs microphone access to record and transcribe your meetings.",
      "NSCameraUsageDescription": "Pluto needs camera access for screen sharing and meeting contexts.",
      "NSAudioCaptureUsageDescription": "Pluto needs permission to capture system audio for transcription.",
      "NSCalendarsFullAccessUsageDescription": "Pluto reads meeting titles, times, and participants to identify recordings and show upcoming meetings.",
      "NSCalendarsUsageDescription": "Pluto reads meeting titles, times, and participants to identify recordings and show upcoming meetings."
    }
  }
}
