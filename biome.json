{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/dist-electron/**",
      "**/python/**",
      "**/release/**",
      "**/resources/bin/**",
      ".agent/**",
      ".agents/**",
      ".claude/**",
      ".superpowers/**",
      ".worktrees/**",
      "tmp/**"
    ]
  }
}
